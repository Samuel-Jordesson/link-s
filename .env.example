# Copie este arquivo para .env e ajuste os valores.
# O .env não vai para o GitHub; este exemplo vai.
# Variáveis definidas no ambiente (ex: painel da Hostinger) têm prioridade sobre o .env.

# Porta do servidor Node (API + site em produção).
# Na Hostinger normalmente não precisa definir: ela informa a porta sozinha.
PORT=3001

# Porta do Vite no desenvolvimento (npm run dev)
CLIENT_PORT=5173

# Onde fica o banco (empresas, links, login e sessões).
# Em produção, use um caminho FORA da pasta do app, senão cada deploy apaga os dados.
# Ex: DB_FILE=/home/SEU_USUARIO/links-data/db.json
DB_FILE=

# Pasta das imagens enviadas (logos, imagens dos links, fundos).
# Mesma regra do DB_FILE: em produção, fora da pasta do app.
# Ex: UPLOAD_DIR=/home/SEU_USUARIO/links-data/uploads
UPLOAD_DIR=
